# === Azure OpenAI ===
AZURE_OPENAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4.1
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# LLM provider: azure_openai (default), or azure_anthropic for Anthropic
# models deployed on the same Azure endpoint (then set ANTHROPIC_MODEL).
LLM_PROVIDER=azure_openai
# ANTHROPIC_MODEL=claude-opus-4-6

# === Telegram ===
# Get from @BotFather on Telegram (see README for steps).
# Leave empty to disable Telegram (it requires a public HTTPS URL).
TELEGRAM_BOT_TOKEN=

# === Evolution API (WhatsApp) ===
# This is a password YOU choose to protect your self-hosted Evolution API.
# Generate one with: openssl rand -hex 32
EVOLUTION_API_KEY=your-chosen-api-key
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_INSTANCE_NAME=msgbot

# === Service URLs (internal docker network) ===
TRANSCRIBER_URL=http://transcriber:8000
TTS_URL=http://tts:8000

# === Bot config ===
# URL where the bot is reachable for webhook callbacks.
# For localhost (WhatsApp only): use the internal Docker hostname:
BOT_URL=http://bot:8000
# For VPS (Telegram + WhatsApp): use your public domain/IP:
# BOT_URL=https://your-domain.com

# Default system prompt for LLM
DEFAULT_SYSTEM_PROMPT=You are a helpful voice assistant. Respond concisely and naturally.

# Response mode: text | voice | auto (voice replies to voice, text to text)
RESPONSE_MODE=auto

# Data directory (SQLite + audio files)
DATA_DIR=/app/data

# === Transcriber (read by docker compose) ===
# Whisper model: tiny | base | small | medium | large-v3 (default, needs a GPU)
WHISPER_MODEL=large-v3
# cuda | cpu | auto
WHISPER_DEVICE=cuda
# 1 loads the model at startup instead of on the first request
WHISPER_PRELOAD=1
